          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "結論を前提にせず、本人の言葉で順序を説明してもらいます。",
            "en": "Without assuming a conclusion, I will ask for the sequence in the person's own words.",
            "zh": "我不預設結論，請對方用自己的話說明順序。"
          },
          "axisScores": {
            "neutrality": 20,
            "fact-checking": 20,
            "contradiction-handling": 20,
            "relationship-impact": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
