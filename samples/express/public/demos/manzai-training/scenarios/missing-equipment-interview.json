          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
