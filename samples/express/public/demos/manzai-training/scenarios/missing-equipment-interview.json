{
  "$schema": "../schemas/scenario.schema.json",
  "id": "missing-equipment-interview",
  "title": {
    "ja": "紛失備品の聞き取り",
    "en": "Interview About Missing Equipment",
    "zh": "遺失設備訪談"
  },
  "description": {
    "ja": "調査面談として「紛失備品の聞き取り」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Interview About Missing Equipment” for Investigative Interview.",
    "zh": "在「遺失設備訪談」中練習符合情境的簡短調查訪談回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "neutrality",
      "label": {
        "ja": "中立性",
        "en": "Neutrality",
        "zh": "中立性"
      },
      "description": {
        "ja": "誘導や決めつけを避ける",
        "en": "Avoid leading language and assumptions.",
        "zh": "避免誘導與預設立場。"
      },
      "maxPoints": 20
    },
    {
      "id": "fact-checking",
      "label": {
        "ja": "事実確認",
        "en": "Fact checking",
        "zh": "事實確認"
      },
      "description": {
        "ja": "推測せず必要な事実を確認する",
        "en": "Verify necessary facts instead of guessing.",
        "zh": "不憑猜測，確認必要事實。"
      },
      "maxPoints": 20
    },
    {
      "id": "contradiction-handling",
      "label": {
        "ja": "矛盾の確認",
        "en": "Contradiction handling",
        "zh": "矛盾確認"
      },
      "description": {
        "ja": "食い違いを穏当に具体化する",
        "en": "Clarify inconsistencies calmly and specifically.",
        "zh": "冷靜且具體地釐清不一致。"
      },
      "maxPoints": 20
    },
    {
      "id": "relationship-impact",
      "label": {
        "ja": "関係への影響",
        "en": "Relationship impact",
        "zh": "關係影響"
      },
      "description": {
        "ja": "継続的な信頼を損なわない",
        "en": "Protect trust in the ongoing relationship.",
        "zh": "維護長期關係中的信任。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "最後に使ったのは私ですが、なくしたと決めつけないでください。",
        "en": "I used it last, but please don't assume I lost it.",
