{
  "$schema": "../schemas/scenario.schema.json",
  "id": "joint-statement-wording",
  "title": {
    "ja": "共同声明の文言",
    "en": "Wording a Joint Statement",
    "zh": "共同聲明措辭"
  },
  "description": {
    "ja": "外交・政治交渉として「共同声明の文言」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Wording a Joint Statement” for Diplomatic Negotiation.",
    "zh": "在「共同聲明措辭」中練習符合情境的簡短外交與政治談判回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "interest-discovery",
      "label": {
        "ja": "利害把握",
        "en": "Interest discovery",
        "zh": "利益探索"
      },
      "description": {
        "ja": "立場の背後にある利害を確認する",
        "en": "Identify interests behind stated positions.",
        "zh": "確認立場背後的利益。"
      },
      "maxPoints": 20
    },
    {
      "id": "face-saving",
      "label": {
        "ja": "面子への配慮",
        "en": "Face saving",
        "zh": "顧全面子"
      },
      "description": {
        "ja": "相手の尊厳を保つ表現を選ぶ",
        "en": "Use language that preserves dignity.",
        "zh": "使用維護對方尊嚴的表達。"
      },
      "maxPoints": 20
    },
    {
      "id": "conditionality",
      "label": {
        "ja": "条件設計",
        "en": "Conditionality",
        "zh": "條件設計"
      },
      "description": {
        "ja": "合意と譲歩に明確な条件を付ける",
        "en": "Attach clear conditions to agreements and concessions.",
        "zh": "為協議與讓步設定明確條件。"
      },
      "maxPoints": 20
    },
    {
      "id": "relationship-impact",
      "label": {
        "ja": "関係への影響",
        "en": "Relationship impact",
        "zh": "關係影響"
      },
      "description": {
        "ja": "継続的な信頼を損なわない",
        "en": "Protect trust in the ongoing relationship.",
        "zh": "維護長期關係中的信任。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "その表現では、我が国が一方的に譲歩したように国内で受け取られます。",
        "en": "That wording will be seen at home as a unilateral concession by our country.",
        "zh": "這種措辭在國內會被視為我方單方面讓步。"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "表明された立場の背後にある国内事情と核心的利益を確認します。",
            "en": "I will clarify the domestic constraints and core interests behind the stated position.",
            "zh": "我會確認公開立場背後的國內限制與核心利益。"
          },
          "axisScores": {
            "interest-discovery": 20,
            "face-saving": 20,
            "conditionality": 20,
            "relationship-impact": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "interest-discovery": 13,
            "face-saving": 11,
            "conditionality": 12,
            "relationship-impact": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
