{
  "$schema": "../schemas/scenario.schema.json",
  "id": "disagreeing-with-manager",
  "title": {
    "ja": "上司への根拠ある反論",
    "en": "Disagreeing with a Manager",
    "zh": "向主管提出異議"
  },
  "description": {
    "ja": "上司・部下との会話として「上司への根拠ある反論」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Disagreeing with a Manager” for Workplace Communication.",
    "zh": "在「向主管提出異議」中練習符合情境的簡短主管與部屬溝通回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "psychological-safety",
      "label": {
        "ja": "心理的安全性",
        "en": "Psychological safety",
        "zh": "心理安全"
      },
      "description": {
        "ja": "率直に話せる余地を守る",
        "en": "Preserve room for candid discussion.",
        "zh": "保留坦誠溝通的空間。"
      },
      "maxPoints": 20
    },
    {
      "id": "clarity",
      "label": {
        "ja": "明瞭さ",
        "en": "Clarity",
        "zh": "清晰度"
      },
      "description": {
        "ja": "短く分かりやすく伝える",
        "en": "Communicate briefly and clearly.",
        "zh": "簡短清楚地表達。"
      },
      "maxPoints": 20
    },
    {
      "id": "fact-checking",
      "label": {
        "ja": "事実確認",
        "en": "Fact checking",
        "zh": "事實確認"
      },
      "description": {
        "ja": "推測せず必要な事実を確認する",
        "en": "Verify necessary facts instead of guessing.",
        "zh": "不憑猜測，確認必要事實。"
      },
      "maxPoints": 20
    },
    {
      "id": "solution-quality",
      "label": {
        "ja": "解決策",
        "en": "Solution quality",
        "zh": "解決方案"
      },
      "description": {
        "ja": "実行可能な次の行動を示す",
        "en": "Offer a workable next action.",
        "zh": "提出可執行的下一步。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "方針は決めました。反対なら、感想ではなく根拠を示してください。",
        "en": "The direction is set. If you disagree, show evidence rather than an opinion.",
        "zh": "方向已經決定。如果反對，請提出依據而不是感想。"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "まず懸念を否定せず、根拠と影響を具体的に聞きます。",
            "en": "I will not dismiss the concern; first I want the evidence and likely impact.",
            "zh": "我不會先否定疑慮，會先了解依據與可能影響。"
          },
          "axisScores": {
            "psychological-safety": 20,
            "clarity": 20,
            "fact-checking": 20,
            "solution-quality": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "psychological-safety": 13,
            "clarity": 11,
            "fact-checking": 12,
            "solution-quality": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
