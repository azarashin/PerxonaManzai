{
  "$schema": "../schemas/scenario.schema.json",
  "id": "suspected-cheating",
  "title": {
    "ja": "カンニングの疑い",
    "en": "Suspected Cheating",
    "zh": "疑似作弊"
  },
  "description": {
    "ja": "教師・生徒として「カンニングの疑い」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Suspected Cheating” for Teacher and Student.",
    "zh": "在「疑似作弊」中練習符合情境的簡短教師與學生回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "empathy",
      "label": {
        "ja": "共感",
        "en": "Empathy",
        "zh": "同理心"
      },
      "description": {
        "ja": "相手の感情や負担を受け止める",
        "en": "Acknowledge the other person's feelings or burden.",
        "zh": "接住對方的感受或負擔。"
      },
      "maxPoints": 20
    },
    {
      "id": "fact-checking",
      "label": {
        "ja": "事実確認",
        "en": "Fact checking",
        "zh": "事實確認"
      },
      "description": {
        "ja": "推測せず必要な事実を確認する",
        "en": "Verify necessary facts instead of guessing.",
        "zh": "不憑猜測，確認必要事實。"
      },
      "maxPoints": 20
    },
    {
      "id": "psychological-safety",
      "label": {
        "ja": "心理的安全性",
        "en": "Psychological safety",
        "zh": "心理安全"
      },
      "description": {
        "ja": "率直に話せる余地を守る",
        "en": "Preserve room for candid discussion.",
        "zh": "保留坦誠溝通的空間。"
      },
      "maxPoints": 20
    },
    {
      "id": "solution-quality",
      "label": {
        "ja": "解決策",
        "en": "Solution quality",
        "zh": "解決方案"
      },
      "description": {
        "ja": "実行可能な次の行動を示す",
        "en": "Offer a workable next action.",
        "zh": "提出可執行的下一步。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "答えが似ているだけで、カンニングしたと決めつけるんですか。",
        "en": "Are you deciding I cheated just because our answers look alike?",
        "zh": "只因答案相似，就認定我作弊嗎？"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "決めつけずに本人の事情と受け止めを聞きます。",
            "en": "I will ask about the student's circumstances without assuming.",
            "zh": "我不預設立場，先了解學生的情況與感受。"
          },
          "axisScores": {
            "empathy": 20,
            "fact-checking": 20,
            "psychological-safety": 20,
            "solution-quality": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "empathy": 13,
            "fact-checking": 11,
            "psychological-safety": 12,
            "solution-quality": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
