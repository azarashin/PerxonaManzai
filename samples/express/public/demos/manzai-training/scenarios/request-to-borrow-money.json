{
  "$schema": "../schemas/scenario.schema.json",
  "id": "request-to-borrow-money",
  "title": {
    "ja": "友人からの借金依頼",
    "en": "A Request to Borrow Money",
    "zh": "朋友借錢請求"
  },
  "description": {
    "ja": "友人同士の相談として「友人からの借金依頼」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “A Request to Borrow Money” for Advice Between Friends.",
    "zh": "在「朋友借錢請求」中練習符合情境的簡短朋友間的商量回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "empathy",
      "label": {
        "ja": "共感",
        "en": "Empathy",
        "zh": "同理心"
      },
      "description": {
        "ja": "相手の感情や負担を受け止める",
        "en": "Acknowledge the other person's feelings or burden.",
        "zh": "接住對方的感受或負擔。"
      },
      "maxPoints": 20
    },
    {
      "id": "needs-reading",
      "label": {
        "ja": "意図の把握",
        "en": "Needs reading",
        "zh": "需求判讀"
      },
      "description": {
        "ja": "共感と助言のどちらが必要かを読む",
        "en": "Read whether empathy or advice is needed.",
        "zh": "判斷對方需要同理還是建議。"
      },
      "maxPoints": 20
    },
    {
      "id": "boundary-keeping",
      "label": {
        "ja": "境界維持",
        "en": "Boundary keeping",
        "zh": "界線維持"
      },
      "description": {
        "ja": "権限外の断定や約束を避ける",
        "en": "Avoid unsupported claims or commitments.",
        "zh": "避免超出權限的斷言或承諾。"
      },
      "maxPoints": 20
    },
    {
      "id": "solution-quality",
      "label": {
        "ja": "解決策",
        "en": "Solution quality",
        "zh": "解決方案"
      },
      "description": {
        "ja": "実行可能な次の行動を示す",
        "en": "Offer a workable next action.",
        "zh": "提出可執行的下一步。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "今月だけお金を貸してほしい。理由は聞かずに助けてくれない？",
        "en": "Could you lend me money just this month without asking why?",
        "zh": "這個月借我一筆錢，可以不要問理由就幫我嗎？"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "すぐ助言せず、今は話を聞いてほしいのか一緒に考えたいのか確認します。",
            "en": "Before advising, I will ask whether you want listening or help thinking it through.",
            "zh": "我先不急著建議，想確認你需要傾聽還是一起思考。"
          },
          "axisScores": {
            "empathy": 20,
            "needs-reading": 20,
            "boundary-keeping": 20,
            "solution-quality": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "empathy": 13,
            "needs-reading": 11,
            "boundary-keeping": 12,
            "solution-quality": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
