{
  "$schema": "../schemas/scenario.schema.json",
  "id": "refusing-safe-evacuation",
  "title": {
    "ja": "避難を拒む人との対話",
    "en": "Refusing Safe Evacuation",
    "zh": "拒絕安全疏散"
  },
  "description": {
    "ja": "危機場面の対話として「避難を拒む人との対話」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Refusing Safe Evacuation” for Crisis Communication.",
    "zh": "在「拒絕安全疏散」中練習符合情境的簡短危機情境溝通回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "emotional-stabilization",
      "label": {
        "ja": "感情の安定",
        "en": "Emotional stabilization",
        "zh": "情緒穩定"
      },
      "description": {
        "ja": "緊張を高めず落ち着きを支える",
        "en": "Support calm without escalating tension.",
        "zh": "協助穩定情緒，不升高緊張。"
      },
      "maxPoints": 20
    },
    {
      "id": "active-listening",
      "label": {
        "ja": "積極的傾聴",
        "en": "Active listening",
        "zh": "積極傾聽"
      },
      "description": {
        "ja": "遮らず要点を確かめる",
        "en": "Listen without interruption and confirm key points.",
        "zh": "不打斷並確認重點。"
      },
      "maxPoints": 20
    },
    {
      "id": "clarity",
      "label": {
        "ja": "明瞭さ",
        "en": "Clarity",
        "zh": "清晰度"
      },
      "description": {
        "ja": "短く分かりやすく伝える",
        "en": "Communicate briefly and clearly.",
        "zh": "簡短清楚地表達。"
      },
      "maxPoints": 20
    },
    {
      "id": "boundary-keeping",
      "label": {
        "ja": "境界維持",
        "en": "Boundary keeping",
        "zh": "界線維持"
      },
      "description": {
        "ja": "権限外の断定や約束を避ける",
        "en": "Avoid unsupported claims or commitments.",
        "zh": "避免超出權限的斷言或承諾。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "ここを離れたら大切な物を失います。安全だと言われても動けません。",
        "en": "If I leave, I'll lose something important. I can't move just because you say it's safe.",
        "zh": "離開這裡就會失去重要物品。就算你說安全，我也無法走。"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "急がせず落ち着いた声で、今いちばん気がかりなことを聞きます。",
            "en": "Without rushing, I will calmly ask what is most concerning right now.",
            "zh": "我不催促，用平靜語氣詢問目前最擔心的事。"
          },
          "axisScores": {
            "emotional-stabilization": 20,
            "active-listening": 20,
            "clarity": 20,
            "boundary-keeping": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "emotional-stabilization": 13,
            "active-listening": 11,
            "clarity": 12,
            "boundary-keeping": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
          },
          "axisScores": {
            "emotional-stabilization": 2,
            "active-listening": 3,
            "clarity": 2,
            "boundary-keeping": 3
          },
          "feedback": {
            "ja": "相手の要点を退けるだけでは情報と信頼を失います。断定せず、まず確認しましょう。",
            "en": "Dismissing the issue loses information and trust. Avoid assumptions and verify first.",
            "zh": "只是否定問題會失去資訊與信任；應避免武斷並先確認。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": -1
            }
          ],
          "routes": [
            {
              "nextBeatId": "recovery"
