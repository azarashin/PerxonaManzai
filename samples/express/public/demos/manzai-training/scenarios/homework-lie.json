{
  "$schema": "../schemas/scenario.schema.json",
  "id": "homework-lie",
  "title": {
    "ja": "宿題についての嘘",
    "en": "A Lie About Homework",
    "zh": "關於功課的謊言"
  },
  "description": {
    "ja": "親子会話として「宿題についての嘘」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “A Lie About Homework” for Parent and Child Communication.",
    "zh": "在「關於功課的謊言」中練習符合情境的簡短親子溝通回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "empathy",
      "label": {
        "ja": "共感",
        "en": "Empathy",
        "zh": "同理心"
      },
      "description": {
        "ja": "相手の感情や負担を受け止める",
        "en": "Acknowledge the other person's feelings or burden.",
        "zh": "接住對方的感受或負擔。"
      },
      "maxPoints": 20
    },
    {
      "id": "boundary-keeping",
      "label": {
        "ja": "境界維持",
        "en": "Boundary keeping",
        "zh": "界線維持"
      },
      "description": {
        "ja": "権限外の断定や約束を避ける",
        "en": "Avoid unsupported claims or commitments.",
        "zh": "避免超出權限的斷言或承諾。"
      },
      "maxPoints": 20
    },
    {
      "id": "relationship-impact",
      "label": {
        "ja": "関係への影響",
        "en": "Relationship impact",
        "zh": "關係影響"
      },
      "description": {
        "ja": "継続的な信頼を損なわない",
        "en": "Protect trust in the ongoing relationship.",
        "zh": "維護長期關係中的信任。"
      },
      "maxPoints": 20
    },
    {
      "id": "solution-quality",
      "label": {
        "ja": "解決策",
        "en": "Solution quality",
        "zh": "解決方案"
      },
      "description": {
        "ja": "実行可能な次の行動を示す",
        "en": "Offer a workable next action.",
        "zh": "提出可執行的下一步。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "宿題をやったって嘘をついた。でも怒られるのが怖かったんだ。",
        "en": "I lied that I finished my homework because I was afraid you'd be angry.",
        "zh": "我謊稱功課寫完了，因為怕你生氣。"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "まず気持ちと理由を聞き、守る必要がある境界も落ち着いて伝えます。",
            "en": "I will hear the feelings and reasons, then calmly state the boundary we must keep.",
            "zh": "我先了解感受與理由，再冷靜說明必須遵守的界線。"
          },
          "axisScores": {
            "empathy": 20,
            "boundary-keeping": 20,
            "relationship-impact": 20,
            "solution-quality": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "empathy": 13,
            "boundary-keeping": 11,
            "relationship-impact": 12,
            "solution-quality": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
          },
          "axisScores": {
            "empathy": 2,
            "boundary-keeping": 3,
            "relationship-impact": 2,
            "solution-quality": 3
