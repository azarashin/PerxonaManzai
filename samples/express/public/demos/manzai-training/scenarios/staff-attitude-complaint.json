{
  "$schema": "../schemas/scenario.schema.json",
  "id": "staff-attitude-complaint",
  "title": {
    "ja": "店員の態度への苦情",
    "en": "Complaint About Staff Attitude",
    "zh": "店員態度客訴"
  },
  "description": {
    "ja": "接客・クレーム対応として「店員の態度への苦情」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Complaint About Staff Attitude” for Customer Service and Complaints.",
    "zh": "在「店員態度客訴」中練習符合情境的簡短顧客服務與客訴回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "empathy",
      "label": {
        "ja": "共感",
        "en": "Empathy",
        "zh": "同理心"
      },
      "description": {
        "ja": "相手の感情や負担を受け止める",
        "en": "Acknowledge the other person's feelings or burden.",
        "zh": "接住對方的感受或負擔。"
      },
      "maxPoints": 20
    },
    {
      "id": "fact-checking",
      "label": {
        "ja": "事実確認",
        "en": "Fact checking",
        "zh": "事實確認"
      },
      "description": {
        "ja": "推測せず必要な事実を確認する",
        "en": "Verify necessary facts instead of guessing.",
        "zh": "不憑猜測，確認必要事實。"
      },
      "maxPoints": 20
    },
    {
      "id": "solution-quality",
      "label": {
        "ja": "解決策",
        "en": "Solution quality",
        "zh": "解決方案"
      },
      "description": {
        "ja": "実行可能な次の行動を示す",
        "en": "Offer a workable next action.",
        "zh": "提出可執行的下一步。"
      },
      "maxPoints": 20
    },
    {
      "id": "boundary-keeping",
      "label": {
        "ja": "境界維持",
        "en": "Boundary keeping",
        "zh": "界線維持"
      },
      "description": {
        "ja": "権限外の断定や約束を避ける",
        "en": "Avoid unsupported claims or commitments.",
        "zh": "避免超出權限的斷言或承諾。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "店員にぞんざいに扱われました。責任者としてどう対応するんですか。",
        "en": "A staff member treated me dismissively. What will you do as the manager?",
        "zh": "店員對我的態度很敷衍。身為主管你要怎麼處理？"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "ご不便を受け止め、まず確認すべき事実を整理します。",
            "en": "I acknowledge the inconvenience and will first verify the relevant facts.",
            "zh": "我理解造成的不便，會先確認相關事實。"
          },
          "axisScores": {
            "empathy": 20,
            "fact-checking": 20,
            "solution-quality": 20,
            "boundary-keeping": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "empathy": 13,
            "fact-checking": 11,
            "solution-quality": 12,
            "boundary-keeping": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
