{
  "$schema": "../schemas/scenario.schema.json",
  "id": "incorrect-public-announcement",
  "title": {
    "ja": "誤った公開案内の訂正",
    "en": "Correcting a Public Announcement",
    "zh": "更正錯誤公告"
  },
  "description": {
    "ja": "謝罪・火消しとして「誤った公開案内の訂正」に対応し、状況に合う短い応答を選ぶ練習です。",
    "en": "Practice concise, context-appropriate responses in “Correcting a Public Announcement” for Apology and Incident Response.",
    "zh": "在「更正錯誤公告」中練習符合情境的簡短道歉與事件應對回應。"
  },
  "startBeatId": "opening",
  "stateVariables": [
    {
      "id": "engagement",
      "label": {
        "ja": "対話の維持",
        "en": "Engagement",
        "zh": "對話投入"
      },
      "description": {
        "ja": "相手が対話を続けられると感じる度合い",
        "en": "How willing the other person is to continue the dialogue.",
        "zh": "對方願意繼續對話的程度。"
      },
      "type": "number",
      "initialValue": 0,
      "minimum": -2,
      "maximum": 2
    },
    {
      "id": "key-point-confirmed",
      "label": {
        "ja": "要点確認",
        "en": "Key point confirmed",
        "zh": "重點已確認"
      },
      "description": {
        "ja": "応答前に中心的な論点を確認できたか",
        "en": "Whether the central issue was confirmed before acting.",
        "zh": "採取行動前是否已確認核心問題。"
      },
      "type": "boolean",
      "initialValue": false
    }
  ],
  "evaluationAxes": [
    {
      "id": "accountability",
      "label": {
        "ja": "責任ある対応",
        "en": "Accountability",
        "zh": "負責態度"
      },
      "description": {
        "ja": "確認済みの影響と責任に向き合う",
        "en": "Address confirmed impact and responsibility.",
        "zh": "面對已確認的影響與責任。"
      },
      "maxPoints": 20
    },
    {
      "id": "fact-checking",
      "label": {
        "ja": "事実確認",
        "en": "Fact checking",
        "zh": "事實確認"
      },
      "description": {
        "ja": "推測せず必要な事実を確認する",
        "en": "Verify necessary facts instead of guessing.",
        "zh": "不憑猜測，確認必要事實。"
      },
      "maxPoints": 20
    },
    {
      "id": "clarity",
      "label": {
        "ja": "明瞭さ",
        "en": "Clarity",
        "zh": "清晰度"
      },
      "description": {
        "ja": "短く分かりやすく伝える",
        "en": "Communicate briefly and clearly.",
        "zh": "簡短清楚地表達。"
      },
      "maxPoints": 20
    },
    {
      "id": "solution-quality",
      "label": {
        "ja": "解決策",
        "en": "Solution quality",
        "zh": "解決方案"
      },
      "description": {
        "ja": "実行可能な次の行動を示す",
        "en": "Offer a workable next action.",
        "zh": "提出可執行的下一步。"
      },
      "maxPoints": 20
    }
  ],
  "beats": [
    {
      "id": "opening",
      "boke": {
        "ja": "昨日の案内が間違っていたせいで、予定を変更しました。",
        "en": "I changed my plans because yesterday's announcement was wrong.",
        "zh": "因為昨天的公告錯誤，我改變了原本的安排。"
      },
      "reaction": {
        "description": {
          "ja": "率直に問題を切り出す",
          "en": "Raise the issue candidly",
          "zh": "坦率提出問題"
        },
        "motionTags": [
          "pose:talking_02",
          "category:talking"
        ],
        "variant": 0,
        "priority": 1,
        "cue": "start"
      },
      "choices": [
        {
          "id": "opening-strong",
          "text": {
            "ja": "影響へのお詫びと、現時点で確認済みの事実を分けて伝えます。",
            "en": "I will apologize for the impact and distinguish confirmed facts from unknowns.",
            "zh": "我會對影響致歉，並區分已確認事實與未知部分。"
          },
          "axisScores": {
            "accountability": 20,
            "fact-checking": 20,
            "clarity": 20,
            "solution-quality": 20
          },
          "feedback": {
            "ja": "相手の要点を受け止め、確認と次の行動を短く結び付けた応答です。",
            "en": "This response acknowledges the key point and links verification to a clear next action.",
            "zh": "這個回應接住重點，並把確認與明確的下一步連結起來。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 1
            },
            {
              "stateId": "key-point-confirmed",
              "operation": "set",
              "value": true
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-partial",
          "text": {
            "ja": "分かりました。少し考えさせてください。",
            "en": "I understand. Let me think about it.",
            "zh": "我明白了，請讓我想一下。"
          },
          "axisScores": {
            "accountability": 13,
            "fact-checking": 11,
            "clarity": 12,
            "solution-quality": 12
          },
          "feedback": {
            "ja": "対話は保てますが、確認事項か次の行動を具体化するとさらに有効です。",
            "en": "This keeps the dialogue open, but it should specify either what to verify or what happens next.",
            "zh": "這能維持對話，但若能具體說明要確認什麼或下一步會更有效。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": 0
            }
          ],
          "routes": [
            {
              "nextBeatId": "clarify"
            }
          ]
        },
        {
          "id": "opening-weak",
          "text": {
            "ja": "それは私の問題ではありません。",
            "en": "That is not my problem.",
            "zh": "那不是我的問題。"
          },
          "axisScores": {
            "accountability": 2,
            "fact-checking": 3,
            "clarity": 2,
            "solution-quality": 3
          },
          "feedback": {
            "ja": "相手の要点を退けるだけでは情報と信頼を失います。断定せず、まず確認しましょう。",
            "en": "Dismissing the issue loses information and trust. Avoid assumptions and verify first.",
            "zh": "只是否定問題會失去資訊與信任；應避免武斷並先確認。"
          },
          "stateEffects": [
            {
              "stateId": "engagement",
              "operation": "add",
              "value": -1
            }
          ],
          "routes": [
            {
              "nextBeatId": "recovery"
