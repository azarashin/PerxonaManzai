{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perxona.example/schemas/scenario.schema.json",
  "title": "Perxona scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "evaluationAxes", "beats"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "startBeatId": { "$ref": "#/$defs/id" },
    "stateVariables": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateVariable" }
    },
    "evaluationAxes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationAxis" }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en", "zh"],
      "properties": {
        "ja": { "$ref": "#/$defs/nonEmptyString" },
        "en": { "$ref": "#/$defs/nonEmptyString" },
        "zh": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "localizedAliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en", "zh"],
      "properties": {
        "ja": { "$ref": "#/$defs/aliasList" },
        "en": { "$ref": "#/$defs/aliasList" },
        "zh": { "$ref": "#/$defs/aliasList" }
      }
    },
    "aliasList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "motionTags"],
      "properties": {
        "description": { "$ref": "#/$defs/localizedText" },
        "motionTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "motionId": { "$ref": "#/$defs/nonEmptyString" },
        "variant": { "type": "integer", "minimum": 0 },
        "priority": { "type": "integer", "minimum": 0 },
        "cue": { "enum": ["start", "end"] }
      }
    },
    "evaluationAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "maxPoints"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "maxPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        }
      }
    },
    "stateValue": {
      "type": ["number", "boolean", "string"]
    },
    "stateVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "type", "initialValue"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "type": { "enum": ["number", "boolean", "string"] },
        "initialValue": { "$ref": "#/$defs/stateValue" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "stateEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "operation", "value"],
      "properties": {
        "stateId": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["set", "add"] },
        "value": { "$ref": "#/$defs/stateValue" }
      }
    },
    "routeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "operator", "value"],
      "properties": {
        "stateId": { "$ref": "#/$defs/id" },
        "operator": {
          "enum": ["equals", "not-equals", "greater-than", "greater-than-or-equal", "less-than", "less-than-or-equal"]
        },
        "value": { "$ref": "#/$defs/stateValue" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextBeatId"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/routeCondition" }
        },
        "nextBeatId": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "axisScores", "feedback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/localizedText" },
        "aliases": {
          "oneOf": [
            { "$ref": "#/$defs/aliasList" },
            { "$ref": "#/$defs/localizedAliases" }
          ]
        },
        "axisScores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          },
          "propertyNames": { "$ref": "#/$defs/id" }
        },
        "stateEffects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateEffect" }
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        },
        "feedback": { "$ref": "#/$defs/localizedText" }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "boke", "reaction", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "boke": { "$ref": "#/$defs/localizedText" },
        "reaction": { "$ref": "#/$defs/reaction" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/choice" }
        }
      }
    }
  }
}
