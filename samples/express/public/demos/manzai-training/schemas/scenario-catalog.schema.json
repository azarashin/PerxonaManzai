{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perxona.example/schemas/scenario-catalog.schema.json",
  "title": "Perxona scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioEntry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en", "zh"],
      "properties": {
        "ja": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "en": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "zh": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "branching"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/localizedText" },
        "branching": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement", "rationale"],
          "properties": {
            "requirement": {
              "enum": ["not-required", "recommended", "required"]
            },
            "rationale": { "$ref": "#/$defs/localizedText" }
          }
        }
      }
    },
    "scenarioEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categoryId", "beatCount", "difficulty", "estimatedMinutes", "learningObjectives", "title", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "categoryId": { "$ref": "#/$defs/id" },
        "beatCount": { "type": "integer", "minimum": 1 },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "learningObjectives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ja", "en", "zh"],
          "properties": {
            "ja": { "$ref": "#/$defs/nonEmptyStringList" },
            "en": { "$ref": "#/$defs/nonEmptyStringList" },
            "zh": { "$ref": "#/$defs/nonEmptyStringList" }
          }
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "path": {
          "type": "string",
          "pattern": "^\\./scenarios/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
        }
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  }
}
