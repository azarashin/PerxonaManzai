{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perxona.example/schemas/scenario-quality-policy.schema.json",
  "title": "Perxona scenario quality policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "mode",
    "languages",
    "normalization",
    "rules",
    "exceptions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "mode": { "enum": ["audit", "enforce"] },
    "languages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["ja", "en", "zh"] }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicodeForm",
        "lowercase",
        "stripWhitespace",
        "stripPunctuationAndSymbols"
      ],
      "properties": {
        "unicodeForm": { "enum": ["NFC", "NFD", "NFKC", "NFKD"] },
        "lowercase": { "type": "boolean" },
        "stripWhitespace": { "type": "boolean" },
        "stripPunctuationAndSymbols": { "type": "boolean" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CHOICE_DUPLICATE_WITHIN_SCENARIO",
        "CHOICE_REUSED_WITHIN_CATEGORY",
        "CHOICE_OVERUSED_ACROSS_CATALOG",
        "DIALOGUE_OVERUSED_ACROSS_CATALOG",
        "FEEDBACK_OVERUSED_ACROSS_CATALOG",
        "SCORES_NOT_DIFFERENTIATED",
        "SPEECH_CHOICE_TOO_LONG",
        "MOTION_TAGS_NOT_VARIED"
      ],
      "properties": {
        "CHOICE_DUPLICATE_WITHIN_SCENARIO": { "$ref": "#/$defs/rule" },
        "CHOICE_REUSED_WITHIN_CATEGORY": { "$ref": "#/$defs/rule" },
        "CHOICE_OVERUSED_ACROSS_CATALOG": { "$ref": "#/$defs/countRule" },
        "DIALOGUE_OVERUSED_ACROSS_CATALOG": { "$ref": "#/$defs/countRule" },
        "FEEDBACK_OVERUSED_ACROSS_CATALOG": { "$ref": "#/$defs/countRule" },
        "SCORES_NOT_DIFFERENTIATED": { "$ref": "#/$defs/rule" },
        "SPEECH_CHOICE_TOO_LONG": { "$ref": "#/$defs/lengthRule" },
        "MOTION_TAGS_NOT_VARIED": { "$ref": "#/$defs/rule" }
      }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ruleId": {
      "enum": [
        "CHOICE_DUPLICATE_WITHIN_SCENARIO",
        "CHOICE_REUSED_WITHIN_CATEGORY",
        "CHOICE_OVERUSED_ACROSS_CATALOG",
        "DIALOGUE_OVERUSED_ACROSS_CATALOG",
        "FEEDBACK_OVERUSED_ACROSS_CATALOG",
        "SCORES_NOT_DIFFERENTIATED",
        "SPEECH_CHOICE_TOO_LONG",
        "MOTION_TAGS_NOT_VARIED"
      ]
    },
    "severity": {
      "enum": ["error", "warning"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" }
      }
    },
    "countRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "maxOccurrences"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "maxOccurrences": { "type": "integer", "minimum": 1 }
      }
    },
    "lengthRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "severity", "maxCharacters"],
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/severity" },
        "maxCharacters": { "type": "integer", "minimum": 1 }
      }
    },
    "exceptionScope": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "categoryId": { "$ref": "#/$defs/id" },
        "scenarioId": { "$ref": "#/$defs/id" },
        "beatId": { "$ref": "#/$defs/id" },
        "choiceId": { "$ref": "#/$defs/id" },
        "language": { "enum": ["ja", "en", "zh"] },
        "normalizedText": { "type": "string", "minLength": 1 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "scope", "reason"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "scope": { "$ref": "#/$defs/exceptionScope" },
        "reason": { "type": "string", "minLength": 20 },
        "owner": { "type": "string", "minLength": 1 },
        "reviewReference": { "type": "string", "minLength": 1 },
        "expiresOn": { "type": "string", "format": "date" }
      }
    }
  }
}
